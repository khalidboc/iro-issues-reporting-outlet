<mxfile host="app.diagrams.net"><diagram name="Ishikawa"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="e" value="Effect: issues reported late or not at all" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4d3a;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="760" y="250" width="220" height="80" as="geometry"/></mxCell><mxCell id="p" value="People: different channels, fear of being named, no case owner" style="rounded=1;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="300" height="80" as="geometry"/></mxCell><mxCell id="pr" value="Process: WhatsApp complaints, no status, offices send people away" style="rounded=1;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="320" height="80" as="geometry"/></mxCell><mxCell id="i" value="Information: no categories, vague place, no reference number" style="rounded=1;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="700" y="40" width="280" height="80" as="geometry"/></mxCell><mxCell id="pl" value="Place: hostels vs town, flood, dark corridors, dry borehole" style="rounded=1;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="300" height="80" as="geometry"/></mxCell><mxCell id="t" value="Tools: no public form, paper gets lost, data cost" style="rounded=1;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="360" y="420" width="300" height="80" as="geometry"/></mxCell><mxCell id="tr" value="Trust: nothing changes, sensitive reports feel unsafe" style="rounded=1;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="680" y="420" width="280" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>